# Enter the BotFather token locally. Never commit or share this file after copying.
BOT_TOKEN=
# JSON array of numeric Telegram user IDs (not usernames).
BOOTSTRAP_ADMIN_IDS=[]
APP_TIMEZONE=Asia/Tehran
DATA_DIR=data
# Keep outside DATA_DIR; never include this directory in database backups.
SECRETS_DIR=.secrets

# Enable only after reviewing the maintenance preview.
RETENTION_ENABLED=false
